{{ form_start(form, {attr: {class: 'row g-3', 'data-turbo': 'false'}}) }}
    <div class="col-md-6">{{ form_row(form.nombre, {label: 'Nombre', attr: {class: 'form-control'}}) }}</div>
    <div class="col-md-6">{{ form_row(form.apellido, {label: 'Apellido', attr: {class: 'form-control'}}) }}</div>
    <div class="col-md-6">{{ form_row(form.email, {label: 'Correo electrónico', attr: {class: 'form-control'}}) }}</div>
    <div class="col-md-6">{{ form_row(form.fechaNacimiento, {label: 'Fecha de nacimiento', attr: {class: 'form-control'}}) }}</div>
    <div class="col-12">{{ form_row(form.domicilio, {label: 'Domicilio', attr: {class: 'form-control'}}) }}</div>
    <div class="col-12 actions pt-2">
        <button class="btn btn-primary px-4">{{ button_label|default('Guardar cliente') }}</button>
        <a class="btn btn-outline-secondary" href="{{ path('app_cliente_index') }}">Cancelar</a>
    </div>
{{ form_end(form) }}
