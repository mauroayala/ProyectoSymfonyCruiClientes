{% extends 'base.html.twig' %}

{% block title %}Venta{% endblock %}

{% block body %}
    <h1>Venta</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ ventum.id }}</td>
            </tr>
            <tr>
                <th>Precio</th>
                <td>{{ ventum.precio }}</td>
            </tr>
            <tr>
                <th>Producto</th>
                <td>{{ ventum.producto }}</td>
            </tr>
            <tr>
                <th>Fecha</th>
                <td>{{ ventum.fecha ? ventum.fecha|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Cantidad</th>
                <td>{{ ventum.cantidad }}</td>
            </tr>
            <tr>
                <th>Dni</th>
                <td>{{ ventum.dni }}</td>
            </tr>
            <tr>
                <th>MedioDePago</th>
                <td>{{ ventum.medioDePago }}</td>
            </tr>
            <tr>
                <th>Direccion</th>
                <td>{{ ventum.direccion }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_venta_index') }}">back to list</a>

    <a href="{{ path('app_venta_edit', {'id': ventum.id}) }}">edit</a>

    {{ include('venta/_delete_form.html.twig') }}
{% endblock %}
