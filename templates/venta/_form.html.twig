{{ form_start(form, {attr: {class: 'row g-3'}}) }}
    <div class="col-md-4">{{ form_row(form.precio, {label: 'Precio', attr: {class: 'form-control'}}) }}</div>
    <div class="col-md-8">{{ form_row(form.producto, {label: 'Producto', attr: {class: 'form-control'}}) }}</div>
    <div class="col-md-4">{{ form_row(form.fecha, {label: 'Fecha', attr: {class: 'form-control'}}) }}</div>
    <div class="col-md-4">{{ form_row(form.cantidad, {label: 'Cantidad', attr: {class: 'form-control'}}) }}</div>
    <div class="col-md-4">{{ form_row(form.dni, {label: 'DNI', attr: {class: 'form-control'}}) }}</div>
    <div class="col-md-6">{{ form_row(form.medioDePago, {label: 'Medio de pago', attr: {class: 'form-control'}}) }}</div>
    <div class="col-md-6">{{ form_row(form.direccion, {label: 'Dirección', attr: {class: 'form-control'}}) }}</div>
    <div class="col-12 actions pt-2">
        <button class="btn btn-primary px-4">{{ button_label|default('Guardar venta') }}</button>
        <a class="btn btn-outline-secondary" href="{{ path('app_venta_index') }}">Cancelar</a>
    </div>
{{ form_end(form) }}
