{{ form_start(form, {attr: {class: 'row g-3'}}) }}
    <div class="col-md-8">{{ form_row(form.nombre, {label: 'Nombre', attr: {class: 'form-control'}}) }}</div>
    <div class="col-md-4">{{ form_row(form.precio, {label: 'Precio', attr: {class: 'form-control'}}) }}</div>
    <div class="col-12">{{ form_row(form.descripcion, {label: 'Descripción', attr: {class: 'form-control'}}) }}</div>
    <div class="col-md-6">{{ form_row(form.estado, {label: 'Producto activo', attr: {class: 'form-check-input'}}) }}</div>
    <div class="col-12 actions pt-2">
        <button class="btn btn-primary px-4">{{ button_label|default('Guardar producto') }}</button>
        <a class="btn btn-outline-secondary" href="{{ path('app_producto_index') }}">Cancelar</a>
    </div>
{{ form_end(form) }}
